# LM Studio
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_MODEL=auto
LM_STUDIO_TIMEOUT=120

# RAG
EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_CACHE_FILE=_rag_cache.json

# Filesystem boundary
AGENT_WORKSPACE_ROOT=

# Dangerous local execution is disabled by default.
ENABLE_DANGEROUS_TOOLS=false

# Optional search API
BOCHA_API_KEY=

# Optional MCP servers and Web allowlist.
# MCP_SERVERS=https://mcp.example.com/mcp;http://localhost:9000/mcp
# MCP_ALLOWED_TOOLS=mcp_0_search;mcp_1_read_file

# Optional Skill directory.
SKILL_DIR=skills
