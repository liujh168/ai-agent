# ============================================================
# AI Agent — 环境变量参考（完整）
# 复制为 .env 后按需填写，未填项使用代码默认值
# .env 文件已在 .gitignore 中，切勿提交凭证
# ============================================================

# ---- LM Studio 模型服务（必需） -------------------------------
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_MODEL=auto
LM_STUDIO_TIMEOUT=120

# ---- RAG 知识库（必需） --------------------------------------
EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_CACHE_FILE=_rag_cache.json
# 多个目录用分号分隔，相对 project_root
RAG_DIRECTORIES=docs/knowledge

# ---- 文件系统边界（可选） ------------------------------------
# 留空则默认 project_root（= ai_agent 目录）
AGENT_WORKSPACE_ROOT=

# ---- 安全（可选） -------------------------------------------
# run_terminal / run_code 默认禁用。CLI 用 --enable-dangerous-tools 更直观
ENABLE_DANGEROUS_TOOLS=false

# ---- 外部搜索 API（可选） -----------------------------------
# 博查 AI 搜索 API key（未配时自动降级 DuckDuckGo）
BOCHA_API_KEY=

# ---- Skill（可选） ------------------------------------------
# 留空或 nonexistent 则跳过 Skill 加载
SKILL_DIR=skills

# ---- MCP 远端服务器（可选） ---------------------------------
# 多个用分号分隔
# MCP_SERVERS=https://mcp.example.com/mcp;http://localhost:9000/mcp
# MCP_ALLOWED_TOOLS=mcp_0_search;mcp_1_read_file

# ---- WordPress 博客发布 Skill（可选） -----------------------
# 站点根地址
WP_URL=https://blog.liujh18.com
# WordPress 用户名（可选；若不填会自动从 WP_APP_PASSWORD 空格分隔解析）
WP_USER=
# 后台 → 用户 → 个人资料 → Application Passwords → 添加新应用密码
# 格式：username xxxx xxxx xxxx xxxx
WP_APP_PASSWORD=
