# 博查 AI 搜索 API Key（可选，不配则降级 DuckDuckGo）
# 去 https://open.bochaai.com/ 注册后创建
BOCHA_API_KEY=

# LM Studio 服务地址（默认 http://localhost:1234/v1）
# LM_STUDIO_BASE_URL=http://localhost:1234/v1

# 指定模型（auto = 使用 LM Studio 当前加载的模型）
# LM_STUDIO_MODEL=auto

# RAG 向量化使用的 embedding 模型
# EMBED_MODEL=text-embedding-nomic-embed-text-v1.5

# RAG 文本分块参数（可选）
# RAG_CHUNK_SIZE=500
# RAG_CHUNK_OVERLAP=50
